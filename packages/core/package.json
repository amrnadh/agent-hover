{
  "name": "@agent-hover/core",
  "version": "0.2.0",
  "description": "Shared engine for Agent Hover: source parsing, prompt formatting and session discovery.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsc",
    "prepack": "npx tsc",
    "dev": "npx tsc --watch"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "gpt-tokenizer": "^2.8.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agent-hover",
    "ast",
    "react",
    "ai-agent",
    "token-estimation",
    "mcp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
