{
  "name": "@agent-hover/mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol (MCP) server for Agent Hover. Connects Claude Desktop, Cursor, and AI agents directly to your running UI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-hover-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsc && chmod +x dist/index.js",
    "prepack": "npx tsc && chmod +x dist/index.js",
    "dev": "npx tsc --watch"
  },
  "dependencies": {
    "@agent-hover/core": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agent-hover",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "react",
    "ai-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arc-coder07/agent-hover.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Arc-coder07/agent-hover#readme",
  "bugs": {
    "url": "https://github.com/Arc-coder07/agent-hover/issues"
  },
  "sideEffects": true
}
