{
  "name": "@agent-hover/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Agent Hover. Connects Claude Desktop, Cursor, and AI agents directly to your running UI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-hover-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "npx tsc",
    "prepack": "npx tsc",
    "dev": "npx tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arc-coder07/agent-hover.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Arc-coder07/agent-hover#readme",
  "keywords": [
    "agent-hover",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "react",
    "ai-agent"
  ],
  "license": "MIT"
}
