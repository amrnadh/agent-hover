{
  "name": "@agent-hover/mcp",
  "version": "0.2.1",
  "description": "MCP server for Agent Hover: Claude Code, Cursor, Codex, Antigravity and other agents pick up the UI changes you ask for on the page, and report back to the element so you can review them.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-hover-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepack": "npx tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "npx tsc --watch"
  },
  "dependencies": {
    "@agent-hover/core": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agent-hover",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "react",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrnadh/agent-hover.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/amrnadh/agent-hover#readme",
  "bugs": {
    "url": "https://github.com/amrnadh/agent-hover/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": true
}
