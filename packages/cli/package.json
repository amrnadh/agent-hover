{
  "name": "agent-hover",
  "version": "0.2.0",
  "description": "Set up and check Agent Hover: npx agent-hover init, doctor, and MCP config for each agent.",
  "type": "module",
  "bin": {
    "agent-hover": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx tsc && chmod +x dist/cli.js",
    "prepack": "npx tsc && chmod +x dist/cli.js",
    "dev": "npx tsc --watch"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agent-hover",
    "vite-plugin",
    "react",
    "mcp",
    "claude-code",
    "cursor",
    "ai-agent",
    "vibe-coding",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrnadh/agent-hover.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/amrnadh/agent-hover#readme",
  "bugs": {
    "url": "https://github.com/amrnadh/agent-hover/issues"
  },
  "sideEffects": true
}
