{
  "name": "@agent-hover/vite",
  "version": "0.2.0",
  "description": "See every UI change your agent makes, right on the page. Dev-only Vite plugin for React: ask for a change on any element, track it there while Claude Code, Cursor, Codex or any MCP agent works, then compare, keep, undo or follow up.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsc",
    "prepack": "npx tsc",
    "dev": "npx tsc --watch"
  },
  "dependencies": {
    "@agent-hover/core": "^0.2.0",
    "@agent-hover/overlay": "^0.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "tinyglobby": "^0.2.17",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "keywords": [
    "agent-hover",
    "vite-plugin",
    "react",
    "ai-agent",
    "mcp",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrnadh/agent-hover.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/amrnadh/agent-hover#readme",
  "bugs": {
    "url": "https://github.com/amrnadh/agent-hover/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": true
}
