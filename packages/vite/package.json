{
  "name": "@agent-hover/vite",
  "version": "0.2.1",
  "description": "Can't describe it? Point at it. Dev-only Vite plugin for React: click any element and Claude Code, Cursor, Codex or any MCP agent gets the exact file, line and styles. Track the task on the element, then compare, keep or undo the change.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsc",
    "prepack": "npx tsc",
    "dev": "npx tsc --watch"
  },
  "dependencies": {
    "@agent-hover/core": "^0.2.1",
    "@agent-hover/overlay": "^0.2.1",
    "@jridgewell/trace-mapping": "^0.3.25",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "tinyglobby": "^0.2.17",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "keywords": [
    "agent-hover",
    "vite-plugin",
    "react",
    "ai-agent",
    "mcp",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrnadh/agent-hover.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/amrnadh/agent-hover#readme",
  "bugs": {
    "url": "https://github.com/amrnadh/agent-hover/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": true
}
