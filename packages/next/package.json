{
  "name": "@agent-hover/next",
  "version": "0.2.1",
  "description": "Can't describe it? Point at it. Agent Hover for Next.js (App Router and Pages Router): click any element and Claude Code, Cursor, Codex or any MCP agent gets the exact file, line and styles.",
  "type": "module",
  "main": "dist/config.js",
  "types": "dist/config.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/cjs/config.js",
      "default": "./dist/config.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js",
      "default": "./dist/script.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js",
      "default": "./dist/document.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npx tsc && npx tsc -p tsconfig.cjs.json && node ../../scripts/repo-tasks.mjs cjs-marker packages/next/dist/cjs",
    "prepack": "npm run build",
    "dev": "npx tsc --watch"
  },
  "dependencies": {
    "@agent-hover/bridge": "^0.2.1",
    "@jridgewell/trace-mapping": "^0.3.25"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=19.0.0"
  },
  "keywords": [
    "agent-hover",
    "nextjs",
    "next",
    "react",
    "ai-agent",
    "mcp",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrnadh/agent-hover.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/amrnadh/agent-hover#readme",
  "bugs": {
    "url": "https://github.com/amrnadh/agent-hover/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
