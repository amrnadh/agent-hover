{
  "name": "agent-hover",
  "version": "0.2.0",
  "private": true,
  "description": "See every UI change your agent makes, right on the page. Keep it or undo it.",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=demo",
    "dev:demo": "npm run dev --workspace=demo -- --force",
    "build": "npm run build:core && npm run build:overlay && npm run build:vite && npm run build:mcp && npm run build:cli",
    "build:core": "npm run build --workspace=@agent-hover/core",
    "build:overlay": "npm run build --workspace=@agent-hover/overlay",
    "build:vite": "npm run build --workspace=@agent-hover/vite",
    "build:mcp": "npm run build --workspace=@agent-hover/mcp",
    "build:cli": "npm run build --workspace=agent-hover",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:license": "node scripts/repo-tasks.mjs sync-license",
    "clean": "node scripts/repo-tasks.mjs clean",
    "typecheck": "node scripts/typecheck.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "test:e2e:isolated": "node scripts/e2e-isolated.mjs",
    "record:demo": "node scripts/record-demo.mjs",
    "screenshots": "node scripts/e2e-isolated.mjs --screenshots e2e/v02-main-flow.spec.ts e2e/v02-verify.spec.ts e2e/v02-dock-sidebar.spec.ts e2e/v02-screenshots-update.spec.ts"
  },
  "keywords": [
    "agent-hover",
    "vite-plugin",
    "react",
    "ai-agent",
    "mcp",
    "devtools",
    "vibe-coding"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
