{
  "name": "agent-hover",
  "version": "0.1.0",
  "private": true,
  "description": "Point at your UI. Your agent understands it.",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=demo",
    "dev:demo": "npm run dev --workspace=demo -- --force",
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace=@agent-hover/core",
    "build:vite": "npm run build --workspace=@agent-hover/vite",
    "build:mcp": "npm run build --workspace=@agent-hover/mcp",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf packages/*/dist demo/dist node_modules/.cache"
  },
  "keywords": [
    "agent-hover",
    "vite-plugin",
    "react",
    "ai-agent",
    "mcp",
    "devtools",
    "vibe-coding"
  ],
  "author": "",
  "license": "MIT"
}
