{
  "name": "agent-hover",
  "version": "0.1.1",
  "private": true,
  "description": "Point at your UI. Your agent understands it.",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=demo",
    "dev:demo": "npm run dev --workspace=demo -- --force",
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace=@agent-hover/core",
    "build:vite": "npm run build --workspace=@agent-hover/vite",
    "build:mcp": "npm run build --workspace=@agent-hover/mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:license": "cp LICENSE packages/core/ && cp LICENSE packages/vite/ && cp LICENSE packages/mcp/",
    "clean": "rm -rf packages/*/dist demo/dist node_modules/.cache"
  },
  "keywords": [
    "agent-hover",
    "vite-plugin",
    "react",
    "ai-agent",
    "mcp",
    "devtools",
    "vibe-coding"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vitest": "^2.1.8"
  }
}
